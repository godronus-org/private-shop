{
  "name": "http_private_shop",
  "version": "0.0.1",
  "description": "FastEdge HTTP app: private members shop",
  "scripts": {
    "build": "npm-run-all -s clean build:wasm",
    "build:wasm": "npx fastedge-build --input ./src/index.tsx --output ./build/http_private_shop.wasm --tsconfig ./tsconfig.json",
    "lint": "eslint src/",
    "clean": "rm -rf build"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@gcoredev/fastedge-sdk-js": "^2.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "npm-run-all2": "^9.0.2",
    "typescript": "5.9.3"
  },
  "keywords": [
    "http",
    "fastedge",
    "react",
    "shop",
    "members"
  ],
  "license": "ISC"
}
